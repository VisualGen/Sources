          <TableColumnHeader><Label>LastSync</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>deviceName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>operatingSystem</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>osVersion</PropertyName></TableColumnItem>
