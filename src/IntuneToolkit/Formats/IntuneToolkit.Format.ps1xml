<?xml version="1.0" encoding="utf-8"?>
<!--
    Default table views for IntuneToolkit objects.
    Only changes what is SHOWN; every property is still on the object
    (use Format-List * or Select-Object * to see all).
-->
<Configuration>
  <ViewDefinitions>

    <View>
      <Name>IntuneToolkit.ManagedDevice</Name>
      <ViewSelectedBy><TypeName>IntuneToolkit.ManagedDevice</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>DeviceName</Label><Width>22</Width></TableColumnHeader>
          <TableColumnHeader><Label>OS</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>OsVersion</Label><Width>16</Width></TableColumnHeader>
